# Copiar a .env (NO se sube a git) y completar.

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=asistencia_db
POSTGRES_USER=asistencia
POSTGRES_PASSWORD=cambiar_esto

# ── Puerto en el host donde escucha la app ────────────────────
APP_PORT=8000
# APP_BIND=127.0.0.1   # solo local (útil si delante va cloudflared/nginx en el mismo host)

# ── Seguridad (generar con: openssl rand -hex 32) ─────────────
SECRET_KEY=cambiar_esto
CRON_SECRET=cambiar_esto

# ── Instancia paralela a producción: MANTENER APAGADO ─────────
# Mientras esta copia comparta datos con otra instancia activa, no debe scrapear Bioalba,
# correr jobs programados, mandar correos ni subir respaldos a Drive.
SYNC_ENABLED=false
SCRAPER_ENABLED=false
BACKUP_ENABLED=false
FEATURE_NOTIFICACIONES_EMAIL=false
# Sincronizacion con BioAlba cada 15 min (cron-sync.sh). Activar cuando esta instancia sea la oficial.
SYNC_CRON_ENABLED=false

# ── Solo si se activan las funciones de arriba ────────────────
# CONTROL_ASISTENCIA_USER=
# CONTROL_ASISTENCIA_PASSWORD=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
